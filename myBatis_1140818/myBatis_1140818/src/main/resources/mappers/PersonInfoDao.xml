<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- mapper 標籤: 用來定義操作資料庫方法的 SQL 語句 -->
<!-- namespace: 用來綁定特定 Dao 介面 -->
<mapper namespace="com.example.myBatis_1140818.dao.PersonInfoDao">
	
	<!-- insert 元素: 對應於 SQL 中的 insert -->
	<!-- id: 綁定介面 dao 裡的方法名稱；等號後面的字串就是方法名稱 -->
	<insert id="addInfo">
		<!-- 原生 SQL 語句 -->
		<!-- #{變數名稱}: 對應到 Dao 的方法參數中 @Param("變數名稱") -->
		insert into person_info (id, user_name, age, city)
		values (#{inputId},
		#{inputName}, #{inputAge}, #{inputCity})
	</insert>

	<insert id="addInfo2">
		<!-- 方法 addInfo2 的參數是 PersonInfo class，所以 #{}中變數名稱就是 PersonInfo 屬性變數名稱 -->
		insert into person_info (id, user_name, age, city)
		values (#{id}, #{userName}, #{age}, #{city})
	</insert>

	<!-- select 元素: 對應於 SQL 中的 select -->
	<!-- resultType: select 的結果要放到哪個容器(dto)中，因為沒有被 spring boot 託管，所以需要完整的路徑 -->
	<select id="selectByCity"
		resultType="com.example.myBatis_1140818.dto.PersonInfo">
		<!-- 此方法的參數是使用 Map，語法中的變數名稱 paramCity 必須要與 Map 中的 key 字串一致 -->
		<!-- 變數名稱 paramCity 就是呼叫此方法前建立的 map 中的 key 的字串 -->
		select * from person_info where city = #{paramCity}
	</select>

	<!-- 使用參數列位置來取值 -->
	<!-- 變數命名有2種: 1. arg0 2. param1 ；arg 後面的數字是 index，從 0 開始， prarm 的 index 
		是從1開始 -->
	<!-- #{arg0}: 對應到 Dao 的方法中第一個位置的參數；index 從 0 開始 -->
	<select id="selectByCityAndAgeGreaterThan"
		resultType="com.example.myBatis_1140818.dto.PersonInfo">
		select * from person_info where city = #{arg0} and age >
		#{arg1}
	</select>

	<!-- 方法的參數是集合，如 List, Set 等 -->
	<!-- 使用 in (#{idList})，會報錯；必須要把集合中的參數拆開重組 -->
	<!-- item 後面的字串是自定義的變數名稱，使用於 foreach 標籤中 -->
	<!-- collection 後面的字串是Dao 方法中使用 @Param 對應的字串，不需要透過 #{參數名}來取對應的值 -->
	<!-- open="(" separator="," close=")" 的用意是將多個參數組合成 ("參數1", "參數2", "參數3") 
		這種格式 -->
	<select id="selectByIdList"
		resultType="com.example.myBatis_1140818.dto.PersonInfo">
		select * from person_info where id in
		<foreach item="idItem" collection="idList" open="("
			separator="," close=")">
			#{idItem}
		</foreach>
	</select>

	<!-- 更新語法 -->
	<update id="updateCityById">
		update person_info set city = #{inputCity} where id =
		#{inputId}
	</update>

	<!-- 刪除語法 -->
	<delete id="deleteById">
		delete from person_info where id = #{inputId}
	</delete>

</mapper>