<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- mapper 標籤: 用來定義操作資料庫方法的 SQL 語句 -->
<!-- namespace: 用來綁定特定 Dao 介面 -->
<mapper namespace="com.example.myBatis_1140818.dao.PersonInfoDao2">

    <!-- 一個 xml 中可以有多個 resultMap -->
	<!-- resultMap 標籤: 用於欄位名稱與 DTO 屬性變數名稱間的映射(mapping) -->
	<!-- resultMap 標籤中的 id: 此 resultMap 的唯一標識 -->
	<!-- resultMap 標籤中的 type: 指定裝資料用的 DTO -->
	<resultMap id="PersonInfoJoinMap"
		type="com.example.myBatis_1140818.dto.PersonInfoJoin">
		<!-- 使用於 JOIN ，使用別名來映射(mapping)-->
		<!-- 將原本 person_info 中的 id 在 select 語法中重新命名為 p_id -->
		<!-- 將原本 orders 中的 id 在 select 語法中重新命名為 o_id -->
		<result property="userId" column="p_id" />
		<result property="orderId" column="o_id" />
		<result property="userName" column="user_name" />
	</resultMap>
	
	 <!-- resultMap 與 resultType 無法同時共存 -->
	<!-- select 標籤中的 resultMap: select 的結果要映射哪個 resultMap 中 -->
	<!-- resultMap 後面的字串就是上面 resultMap 標籤中，id 後面的字串 -->
	<select id="selectByCityAndAgeGreaterThan"
		resultMap="PersonInfoMap">
		select * from person_info where city = #{arg0} and age >=
		#{arg1}
	</select>

	<!-- SQL 語法中有需要串接字串時，要用 concat('%', #{arg0}, '%')；不能直接使用 '%'#{arg0}'%' 串接 -->
	<!-- SQL 語法中的字串是用單引號表示 -->
	<select id="selectByCityLike" resultMap="PersonInfoMap">
		select * from
		person_info where city like concat('%', #{inputKey}, '%')
	</select>

	<select id="selectByUserNameAndCitysIn"
		resultMap="PersonInfoMap">
		select * from person_info where user_name = #{arg0}
		
		<!-- 使用 if 判斷式主要是防止參數整個 List是 null時，對 null 做 foreach 取值時會報錯 -->
		<!-- 關鍵字 test 是 if 條件式的屬性，固定字 -->
		<!-- test 後面的字串是條件式，一樣不需要用 #{}來取值 -->
		<!-- test 的條件成立才會執行 if 標籤中的 SQL 語句 -->
		<!-- SQL 語法中的結束符號(分號;)，要寫在 foreach 標籤的外面 -->
		<!-- 關於 if 條件式中的比較符號有限制，可參閱投影片 P42 -->
		<if test="arg1 != null and arg1.size() > 0">
			and city in
			<foreach item="keywordItem" collection="arg1" open="("
				separator="," close=")">
				#{keywordItem}
			</foreach>;
		</if>

	</select>
</mapper>